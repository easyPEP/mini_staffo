#!/usr/bin/env bash
set -euo pipefail

echo "=== Building Docker images..."
docker compose build api

echo "=== Installing dependencies..."
docker compose run --rm api bundle install

echo "=== Preparing database..."
docker compose run --rm api bundle exec rails db:prepare

echo "=== Seeding database..."
docker compose run --rm api bundle exec rails db:seed

echo "=== Generating OpenAPI schema..."
docker compose run --rm api bundle exec rails rswag

echo "=== Setup complete! Run 'bin/dev up' to start the app."
